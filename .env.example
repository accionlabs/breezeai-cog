# breezeai-cog environment variables.
#
# Copy to `.env` (auto-loaded) and uncomment what you need. Every value shown is the
# default. CLI flags override env vars. Most vars use the BREEZEAI_COG_ prefix; AWS and
# a few backend vars also accept their conventional unprefixed names (noted inline).

# ── Analysis ──────────────────────────────────────────────────────────────────
# Comma-separated language allow-list; empty = auto-detect all. (alias: BREEZEAI_COG_LANGUAGES)
#BREEZEAI_COG_LANGUAGE=
# Emit in-body statements (route / API / DB detection): 1|true|yes
#BREEZEAI_COG_CAPTURE_STATEMENTS=false
# Worker processes; empty = CPU count
#BREEZEAI_COG_JOBS=
# Max statement `text` length (chars); longer statements are split into ordered
# `#partNofN` parts (each flagged isPartial) instead of dropped. 0 disables.
#BREEZEAI_COG_STATEMENT_TEXT_LIMIT=8000
# Cap on parts one oversized statement may split into (backstop against node
# explosion); over the cap the tail is dropped + marked + logged. 0 = unbounded.
#BREEZEAI_COG_MAX_STATEMENT_PARTS=0
# Skip files larger than this (bytes)
#BREEZEAI_COG_MAX_FILE_SIZE=2000000
# Per-file tree-sitter parse timeout (seconds; 0 disables)
#BREEZEAI_COG_PARSE_TIMEOUT=10.0

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
#BREEZEAI_COG_LOG_LEVEL=INFO
# plaintext | json
#BREEZEAI_COG_LOG_FORMAT=plaintext
#BREEZEAI_COG_LOG_TO_FILE=true
#BREEZEAI_COG_LOG_LOCATION=./logs

# ── Server ────────────────────────────────────────────────────────────────────
#BREEZEAI_COG_PORT=3000

# ── Backend upload / notification ─────────────────────────────────────────────
# Upload analysis to the backend: 1|true|yes. Requires baseurl + uuid + user_api_key.
#BREEZEAI_COG_UPLOAD=false
# Breeze backend base URL. (alias: BREEZE_API_URL)
#BREEZEAI_COG_BASEURL=
#BREEZEAI_COG_UUID=
# Backend API key — sent as the `api-key` header. (alias: API_KEY)  [SECRET]
#BREEZEAI_COG_USER_API_KEY=
# Per-repo upload timeout in seconds; the request fails/retries past this (default 15 min).
#BREEZEAI_COG_UPLOAD_TIMEOUT=900
# Concurrent uploads in --batch mode.
#BREEZEAI_COG_UPLOAD_PARALLELISM=1
# Retries after a failed upload (total attempts = retries + 1). 4xx is fatal (never retried).
#BREEZEAI_COG_UPLOAD_MAX_RETRIES=1

# ── Git / SCM providers (server: analyze-diff) ────────────────────────────────
# Cap in seconds on each git clone / fetch / checkout subprocess.
#BREEZEAI_COG_GIT_CLONE_TIMEOUT=1800
# REST API base per provider. Override for GitHub Enterprise, self-hosted GitLab,
# Bitbucket Server or Azure DevOps Server; defaults are the public clouds.
#BREEZEAI_COG_GITHUB_API_BASE_URL=https://api.github.com
#BREEZEAI_COG_GITLAB_API_BASE_URL=https://gitlab.com/api/v4
#BREEZEAI_COG_BITBUCKET_API_BASE_URL=https://api.bitbucket.org/2.0
#BREEZEAI_COG_AZURE_DEVOPS_API_BASE_URL=https://dev.azure.com
# Per-request timeout (seconds) for provider REST calls.
#BREEZEAI_COG_SCM_API_TIMEOUT=60
# Retries after a transient failure (429/502/503/504, connect/read errors). 0 = one try.
#BREEZEAI_COG_SCM_API_RETRY_MAX=3
# Base backoff in seconds; doubled per attempt, jittered, capped at 60.
#BREEZEAI_COG_SCM_API_RETRY_BACKOFF_SECONDS=2
# Pagination ceiling per listing; reaching it logs a warning and truncates.
#BREEZEAI_COG_SCM_MAX_PAGES=100
# Global fallback token per provider when a request carries no gitToken. Bitbucket
# expects "username:api_key". Unset = anonymous (public repos only).  [SECRET]
#BREEZEAI_COG_SCM_TOKEN_GITHUB=
#BREEZEAI_COG_SCM_TOKEN_GITLAB=
#BREEZEAI_COG_SCM_TOKEN_BITBUCKET=
#BREEZEAI_COG_SCM_TOKEN_AZURE_DEVOPS=
# Self-hosted instances, as JSON. host -> provider slug, and host -> REST API base.
#BREEZEAI_COG_SCM_INSTANCES={"git.acme.com": "gitlab"}
#BREEZEAI_COG_SCM_INSTANCE_BASE_URL_MAPPING={"git.acme.com": "https://git.acme.com/api/v4"}

# ── AWS / S3 (streaming endpoints: analyze-diff / analyze-sql / analyze-es) ────
# Conventional unprefixed names. (AWS_ACCESS_KEY alias: AWS_ACCESS_KEYID)
# Credentials default to boto3's provider chain — IAM Roles for Service Accounts
# (IRSA) in-cluster, or your local AWS profile for dev. Static keys are optional:
# uncomment BOTH below (e.g. for local dev without a profile) and they take
# precedence over the provider chain.
#AWS_ACCESS_KEY=
#AWS_SECRET_KEY=                 # [SECRET]
#AWS_REGION=us-west-2
#AWS_S3_BUCKET=

# ── Infra / object storage (server) ───────────────────────────────────────────
# Cloud provider backing the streaming uploads; selects the provider-specific
# implementation created by the infra factory.
#BREEZEAI_COG_INFRA_PROVIDER=aws
# Retries per storage request, performed by the provider SDK. botocore counts
# RETRIES here, so 3 means up to 4 total attempts.
#BREEZEAI_COG_STORAGE_RETRY_ATTEMPTS=3
# Seconds to establish a connection to the storage endpoint.
#BREEZEAI_COG_STORAGE_CONNECT_TIMEOUT=10
# Seconds to wait for a response from the storage endpoint.
#BREEZEAI_COG_STORAGE_READ_TIMEOUT=60
